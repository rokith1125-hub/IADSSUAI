# Flask
SECRET_KEY=change-me
FLASK_ENV=development
FLASK_DEBUG=true

# Local Storage (JSON Files - No Database Required)
# Data stored in backend/data/ folder
DATA_DIR=data

# Firebase (client SDK keys)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin (service account)
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# AI Keys
GROQ_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Weather
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# Image APIs (all FREE)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Pollinations AI - FREE AI Image Generation (no key needed)
POLLINATIONS_API_URL=https://image.pollinations.ai/prompt

# Market
AGMARKNET_API_KEY=

# Cloudinary (optional PDF/image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT
JWT_SECRET_KEY=change-me-jwt

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Logging
LOG_LEVEL=INFO


